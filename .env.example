# Copie para .env.local e preencha. Nunca faça commit de chaves.

# Provedor de IA: groq | google | anthropic
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Reserva para o futuro (não usada no MVP)
RIOT_API_KEY=

# OP.GG MCP (sem chave)
OPGG_MCP_URL=https://mcp-api.op.gg/mcp

# Região padrão
DEFAULT_REGION=br
